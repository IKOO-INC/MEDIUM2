# Cloudinary signed upload configuration
# Pilih salah satu cara konfigurasi.

# Cara 1: tiga variabel terpisah
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Folder asset di Cloudinary
CLOUDINARY_FOLDER=media-roudlotul-ulum

# Alternatif cara 2 (boleh dipakai menggantikan tiga variabel di atas):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Flask session (wajib diganti dengan string acak saat production)
SECRET_KEY=change-this-with-a-long-random-secret

# FYY AI / Gemini Developer API (tersedia Free Tier dengan batas kuota)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Log chat sementara di MongoDB, 1-168 jam
FYY_AI_LOG_TTL_HOURS=24
